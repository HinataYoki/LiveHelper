<arc:ArcWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
               xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
               xmlns:pages="clr-namespace:LiveHelper.Desktop.Views.Pages"
               xmlns:vm="clr-namespace:LiveHelper.Desktop.ViewModels"
               x:Class="LiveHelper.Desktop.Views.MainWindow"
               x:DataType="vm:MainWindowViewModel"
               x:CompileBindings="True"
               Title="LiveHelper - 多平台直播监控录制"
               Width="1440"
               Height="900"
               MinWidth="1080"
               MinHeight="720"
               WindowStartupLocation="CenterScreen"
               Icon="/Assets/livehelper.ico"
               Background="{arc:ArcDesignTokenResource Background}"
               FontFamily="Geist, PingFang SC, Microsoft YaHei UI">
  <arc:ArcWindow.TitleBar>
    <arc:TitleBar Height="48"
                  Title="LiveHelper"
                  CaptionButtons="Auto">
      <arc:TitleBar.Icon>
        <Border Width="22"
                Height="22"
                CornerRadius="7"
                Background="{arc:ArcDesignTokenResource Accent}">
          <TextBlock Text="L"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontFamily="Geist, PingFang SC"
                     FontSize="12"
                     FontWeight="Bold"
                     Foreground="{arc:ArcDesignTokenResource AccentForeground}" />
        </Border>
      </arc:TitleBar.Icon>

      <arc:TitleBar.LeftContent>
        <TextBlock Text="MULTI-STREAM CONTROL"
                   Margin="18,0,0,0"
                   VerticalAlignment="Center"
                   FontFamily="Geist Mono, Consolas"
                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                   FontWeight="SemiBold"
                   LetterSpacing="1.4"
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
      </arc:TitleBar.LeftContent>

      <arc:TitleBar.CenterContent>
        <Border Width="292"
                Padding="10,5"
                CornerRadius="999"
                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                BorderThickness="1">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Border Width="7" Height="7"
                    CornerRadius="4"
                    Background="{Binding MonitoringBrush}"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding MonitoringStatusText}"
                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2"
                       Text="{Binding ClockText}"
                       FontFamily="Geist Mono, Consolas"
                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
          </Grid>
        </Border>
      </arc:TitleBar.CenterContent>

      <arc:TitleBar.RightContent>
        <StackPanel Orientation="Horizontal"
                    Spacing="7"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">
          <lucide:LucideIcon Kind="HardDrive" Size="13"
                             Foreground="{arc:ArcDesignTokenResource TextMuted}" />
          <TextBlock Text="{Binding TotalRecordedSizeText}"
                     FontFamily="Geist Mono, Consolas"
                     FontSize="{arc:ArcDesignTokenResource TypeXS}"
                     Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        </StackPanel>
      </arc:TitleBar.RightContent>
    </arc:TitleBar>
  </arc:ArcWindow.TitleBar>

  <arc:ArcWindow.Styles>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontFamily" Value="Geist Mono, Consolas" />
      <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.25" />
      <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
    </Style>

    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource Type2XL}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
    </Style>

    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeLG}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
    </Style>

    <Style Selector="TextBlock.deck-label">
      <Setter Property="FontFamily" Value="Geist Mono, Consolas" />
      <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="0.5" />
      <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
    </Style>

    <Style Selector="TextBlock.deck-value">
      <Setter Property="FontFamily" Value="Geist Mono, Consolas" />
      <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource Type3XL}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
    </Style>

    <Style Selector="TextBlock.deck-value-small">
      <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource Type2XL}" />
    </Style>

    <Style Selector="TextBlock.deck-context">
      <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
      <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
    </Style>

    <Style Selector="TextBlock.legend-text">
      <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
      <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
    </Style>

    <Style Selector="TextBlock.micro-label">
      <Setter Property="FontFamily" Value="Geist Mono, Consolas" />
      <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="0.4" />
      <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
      <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
      <Setter Property="Padding" Value="20" />
    </Style>

    <Style Selector="Border.panel-compact">
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.table-panel">
      <Setter Property="Padding" Value="18" />
    </Style>

    <Style Selector="Border.signal-panel">
      <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
      <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
      <Setter Property="Padding" Value="24" />
    </Style>

    <Style Selector="arc|Input">
      <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
    </Style>

    <Style Selector="arc|Sidebar :is(Control).rail-fade">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="arc|Sidebar:collapsed :is(Control).rail-fade">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="arc|Sidebar:motion-full :is(Control).rail-fade">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
  </arc:ArcWindow.Styles>

  <Grid>
    <Grid ColumnDefinitions="Auto,*">
      <arc:Sidebar x:Name="Nav"
                   Grid.Column="0"
                   SelectedKey="{Binding ActivePageKey, Mode=TwoWay}"
                   Label="主导航"
                   IsFilterVisible="False"
                   ResizeMode="Overlay"
                   CollapseButtonText="收起导航"
                   ExpandButtonText="展开导航">
        <arc:Sidebar.Header>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="4,0,0,0">
            <Border Width="30" Height="30"
                    CornerRadius="9"
                    Background="{arc:ArcDesignTokenResource Accent}">
              <TextBlock Text="L"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontFamily="Geist, PingFang SC"
                         FontSize="15"
                         FontWeight="Bold"
                         Foreground="{arc:ArcDesignTokenResource AccentForeground}" />
            </Border>
            <StackPanel Grid.Column="1"
                        Classes="rail-fade"
                        Spacing="1"
                        VerticalAlignment="Center">
              <TextBlock Text="LiveHelper"
                         FontSize="{arc:ArcDesignTokenResource TypeSM}"
                         FontWeight="SemiBold"
                         Foreground="{arc:ArcDesignTokenResource Foreground}" />
              <TextBlock Text="夜间播控台"
                         FontSize="{arc:ArcDesignTokenResource TypeXS}"
                         Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            </StackPanel>
          </Grid>
        </arc:Sidebar.Header>

        <arc:SidebarSection Header="监控">
          <arc:SidebarItem Key="overview"
                           Label="巡检总览"
                           Icon="{x:Static arc:ArcIcons.Activity}" />
          <arc:SidebarItem Key="rooms"
                           Label="直播间矩阵"
                           Icon="{x:Static arc:ArcIcons.LayoutGrid}" />
          <arc:SidebarItem Key="recordings"
                           Label="录制档案"
                           Icon="{x:Static arc:ArcIcons.Archive}" />
        </arc:SidebarSection>

        <arc:SidebarSection Header="配置">
          <arc:SidebarItem Key="settings"
                           Label="系统设置"
                           Icon="{x:Static arc:ArcIcons.Settings}" />
        </arc:SidebarSection>

        <arc:Sidebar.Footer>
          <StackPanel Spacing="9" Margin="4,0,0,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
              <arc:Button Width="36"
                          Height="36"
                          Padding="0"
                          Variant="Ghost"
                          Command="{Binding ToggleMonitoringCommand}"
                          ToolTip.Tip="{Binding MonitoringButtonText}"
                          AutomationProperties.Name="{Binding MonitoringButtonText}">
                <lucide:LucideIcon Kind="Power" Size="15" />
              </arc:Button>
              <StackPanel Grid.Column="1"
                          Classes="rail-fade"
                          Spacing="2"
                          VerticalAlignment="Center">
                <TextBlock Text="{Binding MonitoringStatusText}"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                           FontWeight="Medium"
                           Foreground="{arc:ArcDesignTokenResource Foreground}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding NextScanText}"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>

            <StackPanel Classes="rail-fade" Spacing="1">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <lucide:LucideIcon Kind="CheckCircle2" Size="11"
                                   Foreground="{arc:ArcDesignTokenResource Success}"
                                   VerticalAlignment="Center" />
                <TextBlock Text="录制引擎 · 内置"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
              </StackPanel>
              <TextBlock Text="{Binding SessionDurationText, StringFormat='会话 {0}'}"
                         FontFamily="Geist Mono, Consolas"
                         FontSize="{arc:ArcDesignTokenResource TypeXS}"
                         Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            </StackPanel>
          </StackPanel>
        </arc:Sidebar.Footer>
      </arc:Sidebar>

      <Grid Grid.Column="1"
            RowDefinitions="Auto,1,*"
            RenderTransform="{Binding #Nav.PageShift}">
        <Grid Grid.Row="0"
              Margin="28,18,28,16"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="24">
          <StackPanel Spacing="5">
            <TextBlock Text="{Binding PageEyebrow}" Classes="eyebrow" />
            <TextBlock Text="{Binding PageTitle}" Classes="page-title" />
            <TextBlock Text="{Binding PageDescription}"
                       MaxWidth="620"
                       HorizontalAlignment="Left"
                       TextWrapping="Wrap"
                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Bottom">
            <arc:Button Variant="Secondary"
                        Command="{Binding ScanNowCommand}"
                        IsLoading="{Binding IsScanning}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <lucide:LucideIcon Kind="ScanLine" Size="14" />
                <TextBlock Text="{Binding ScanButtonText}"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}" />
              </StackPanel>
            </arc:Button>

            <arc:Button Variant="Primary"
                        Command="{Binding AddRoomCommand}"
                        IsVisible="{Binding ShowsRoomActions}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <lucide:LucideIcon Kind="Plus" Size="14" />
                <TextBlock Text="添加直播间"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}" />
              </StackPanel>
            </arc:Button>

            <arc:Button Variant="Primary"
                        Command="{Binding SaveSettingsCommand}"
                        IsVisible="{Binding IsSettingsPage}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <lucide:LucideIcon Kind="CheckCircle2" Size="14" />
                <TextBlock Text="保存并应用"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}" />
              </StackPanel>
            </arc:Button>
          </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{arc:ArcDesignTokenResource BorderSubtle}" />

        <Grid Grid.Row="2">
          <pages:OverviewPage IsVisible="{Binding IsOverviewPage}" />
          <pages:RoomsPage IsVisible="{Binding IsRoomsPage}" />
          <pages:RecordingsPage IsVisible="{Binding IsRecordingsPage}" />
          <pages:PreferencesPage IsVisible="{Binding IsSettingsPage}" />
        </Grid>
      </Grid>
    </Grid>

    <arc:Dialog Title="添加直播间"
                Description="粘贴直播间地址，平台会自动识别；添加后可继续调整监控与录制策略。"
                IsOpen="{Binding IsAddRoomOpen, Mode=TwoWay}"
                Size="Large">
      <StackPanel Spacing="16">
        <Border Background="{Binding NewRoomPlatformSoftBrush}"
                BorderBrush="{Binding NewRoomPlatformBrush}"
                BorderThickness="1"
                CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                Padding="13">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border Width="34" Height="34"
                    CornerRadius="10"
                    Background="{arc:ArcDesignTokenResource Accent}">
              <lucide:LucideIcon Kind="RadioTower" Size="16"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{arc:ArcDesignTokenResource AccentForeground}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding NewRoomPlatformName}"
                         FontSize="{arc:ArcDesignTokenResource TypeSM}"
                         FontWeight="SemiBold"
                         Foreground="{Binding NewRoomPlatformBrush}" />
              <TextBlock Text="{Binding NewRoomPlatformHint}"
                         FontSize="{arc:ArcDesignTokenResource TypeXS}"
                         Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>

        <arc:Input Label="直播间地址"
                   Placeholder="https://live.bilibili.com/..."
                   Text="{Binding NewRoomUrl, Mode=TwoWay}"
                   IsInvalid="{Binding HasAddRoomError}"
                   ErrorMessage="{Binding AddRoomError}" />

        <arc:Input Label="自定义名称"
                   Placeholder="留空则优先使用主播名"
                   Text="{Binding NewRoomName, Mode=TwoWay}" />

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
          <StackPanel Spacing="2">
            <TextBlock Text="自动录制"
                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                       FontWeight="Medium"
                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
            <TextBlock Text="检测到开播且获得媒体流后自动开始录制。"
                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <arc:Switch Grid.Column="1"
                      IsChecked="{Binding NewRoomAutoRecord, Mode=TwoWay}"
                      VerticalAlignment="Center" />
        </Grid>
      </StackPanel>

      <arc:Dialog.Actions>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <arc:Button Variant="Secondary"
                      Command="{Binding CancelAddRoomCommand}"
                      Content="取消" />
          <arc:Button Variant="Primary"
                      Command="{Binding ConfirmAddRoomCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <lucide:LucideIcon Kind="Plus" Size="14" />
              <TextBlock Text="加入监控"
                         FontSize="{arc:ArcDesignTokenResource TypeXS}" />
            </StackPanel>
          </arc:Button>
        </StackPanel>
      </arc:Dialog.Actions>
    </arc:Dialog>
  </Grid>
</arc:ArcWindow>
